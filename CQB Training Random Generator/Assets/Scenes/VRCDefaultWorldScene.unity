  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The first person moves directly toward the threat to rapidly gain a dominant
    shooting position, while a second person moves across the danger area to cover.
    \\n \t1\u4EBA\u76EE\u306F\u8105\u5A01\u306B\u5411\u304B\u3063\u3066\u76F4\u9032\u3057\u3001\u7D20\u65E9\u304F\u6709\u5229\u306A\u5C04\u6483\u4F4D\u7F6E\u3092\u78BA\u4FDD\u3059\u308B\u4E00\u65B9\u30012\u4EBA\u76EE\u306F\u5371\u967A\u533A\u57DF\u3092\u6A2A\u5207\u3063\u3066\u79FB\u52D5\u3057\u3001\u63F4\u8B77\u306B\u3042\u305F\u308B\u3002
    \\n \t\u7B2C\u4E00\u540D\u961F\u5458\u76F4\u63A5\u671D\u5A01\u80C1\u65B9\u5411\u79FB\u52A8\uFF0C\u4EE5\u8FC5\u901F\u5360\u636E\u6709\u5229\u5C04\u51FB\u4F4D\u7F6E\uFF0C\u800C\u7B2C\u4E8C\u540D\u961F\u5458\u5219\u6A2A\u7A7F\u5371\u9669\u533A\u57DF\u8FDB\u884C\u63A9\u62A4\u3002
    \\n \tLa primera persona avanza directamente hacia la amenaza para conseguir
    r\xE1pidamente una posici\xF3n dominante desde la que disparar, mientras que
    una segunda persona se desplaza a trav\xE9s de la zona de peligro para brindar
    cobertura.\\n \uCCAB \uBC88\uC9F8 \uC694\uC6D0\uC740 \uC704\uD611\uC744 \uD5A5\uD574
    \uC9C1\uC9C4\uD558\uC5EC \uC2E0\uC18D\uD558\uAC8C \uC720\uB9AC\uD55C \uC0AC\uACA9
    \uC704\uCE58\uB97C \uD655\uBCF4\uD558\uB294 \uD55C\uD3B8, \uB450 \uBC88\uC9F8
    \uC694\uC6D0\uC740 \uC704\uD5D8 \uAD6C\uC5ED\uC744 \uAC00\uB85C\uC9C8\uB7EC \uC774\uB3D9\uD558\uBA70
    \uC5C4\uD638\uB97C \uB2F4\uB2F9\uD55C\uB2E4."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e4797538af5c9fe479a11371f76b452e, type: 2}
