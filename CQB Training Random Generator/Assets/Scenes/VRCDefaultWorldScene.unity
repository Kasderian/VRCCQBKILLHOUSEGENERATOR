  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 2100000, guid: 35630e38b4e5ffb40b44ec5348b4333f, type: 2}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A fast, fluid approach that emphasizes rapid movement, aggression, and
    adapting quickly to changing threats. \\n Greater risk of losing coordination,
    security, and situational awareness.  \\n \t\u7D20\u65E9\u3044\u52D5\u304D\u3001\u653B\u6483\u6027\u3001\u305D\u3057\u3066\u5909\u5316\u3059\u308B\u8105\u5A01\u3078\u306E\u8FC5\u901F\u306A\u9069\u5FDC\u3092\u91CD\u8996\u3057\u305F\u3001\u8FC5\u901F\u304B\u3064\u6D41\u52D5\u7684\u306A\u30A2\u30D7\u30ED\u30FC\u30C1\u3002\\n
    \u5354\u8ABF\u6027\u3001\u5B89\u5168\u6027\u3001\u72B6\u6CC1\u8A8D\u8B58\u3092\u5931\u3046\u30EA\u30B9\u30AF\u304C\u9AD8\u307E\u308B\u3002
    \\n \t\u4E00\u79CD\u5FEB\u901F\u3001\u6D41\u7545\u7684\u4F5C\u6218\u65B9\u5F0F\uFF0C\u5F3A\u8C03\u5FEB\u901F\u79FB\u52A8\u3001\u5F3A\u653B\u4EE5\u53CA\u8FC5\u901F\u9002\u5E94\u4E0D\u65AD\u53D8\u5316\u7684\u5A01\u80C1\u3002\\n
    \u66F4\u5BB9\u6613\u5BFC\u81F4\u534F\u8C03\u6027\u3001\u5B89\u5168\u6027\u548C\u6001\u52BF\u611F\u77E5\u80FD\u529B\u7684\u4E27\u5931\u3002
    \\n \tUn enfoque r\xE1pido y fluido que hace hincapi\xE9 en los movimientos r\xE1pidos,
    la agresividad y la adaptaci\xF3n r\xE1pida a amenazas cambiantes. \\n Mayor
    riesgo de perder la coordinaci\xF3n, la seguridad y la conciencia situacional.
    \\n \uBE60\uB978 \uC6C0\uC9C1\uC784, \uACF5\uACA9\uC131, \uADF8\uB9AC\uACE0 \uBCC0\uD654\uD558\uB294
    \uC704\uD611\uC5D0 \uC2E0\uC18D\uD558\uAC8C \uC801\uC751\uD558\uB294 \uAC83\uC744
    \uC911\uC2DC\uD558\uB294 \uBE60\uB974\uACE0 \uC720\uC5F0\uD55C \uC811\uADFC \uBC29\uC2DD.
    \\n \uC870\uC815\uB825, \uC548\uC804\uC131, \uC0C1\uD669 \uC778\uC2DD\uC744 \uC0C1\uC2E4\uD560
    \uC704\uD5D8\uC774 \uB354 \uD06C\uB2E4."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e4797538af5c9fe479a11371f76b452e, type: 2}
