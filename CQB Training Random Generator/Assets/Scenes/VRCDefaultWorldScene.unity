  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Close Quarters Battle (CQB) refers to operations conducted at very short
    distances, typically in confined environments such as rooms, corridors, trenches
    and large vehicles.  \\n \t\u8FD1\u63A5\u6226\u95D8\uFF08CQB\uFF09\u3068\u306F\u3001\u6975\u3081\u3066\u81F3\u8FD1\u8DDD\u96E2\u3067\u884C\u308F\u308C\u308B\u4F5C\u6226\u3092\u6307\u3057\u3001\u901A\u5E38\u306F\u90E8\u5C4B\u3001\u5ECA\u4E0B\u3001\u5879\u58D5\u3001\u5927\u578B\u8ECA\u4E21\u306A\u3069\u306E\u9589\u9396\u7684\u306A\u74B0\u5883\u3067\u884C\u308F\u308C\u308B\u3002
    \\n \t\u8FD1\u8DDD\u79BB\u6218\u6597\uFF08CQB\uFF09\u662F\u6307\u5728\u6781\u77ED\u8DDD\u79BB\u5185\u8FDB\u884C\u7684\u4F5C\u6218\u884C\u52A8\uFF0C\u901A\u5E38\u53D1\u751F\u5728\u623F\u95F4\u3001\u8D70\u5ECA\u3001\u6218\u58D5\u53CA\u5927\u578B\u8F66\u8F86\u7B49\u5BC6\u95ED\u73AF\u5883\u4E2D\u3002
    \\n \tEl combate en espacios cerrados (CQB, por sus siglas en ingl\xE9s) se refiere
    a operaciones llevadas a cabo a muy corta distancia, generalmente en entornos
    confinados como habitaciones, pasillos, trincheras y veh\xEDculos de gran tama\xF1o.
    \\n\t\uADFC\uC811\uC804(CQB)\uC774\uB780 \uB9E4\uC6B0 \uAC00\uAE4C\uC6B4 \uAC70\uB9AC\uC5D0\uC11C
    \uC218\uD589\uB418\uB294 \uC791\uC804\uC744 \uB9D0\uD558\uBA70, \uC77C\uBC18\uC801\uC73C\uB85C
    \uBC29, \uBCF5\uB3C4, \uCC38\uD638, \uB300\uD615 \uCC28\uB7C9\uACFC \uAC19\uC740
    \uD611\uC18C\uD55C \uD658\uACBD\uC5D0\uC11C \uC774\uB8E8\uC5B4\uC9D1\uB2C8\uB2E4.
    \\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e4797538af5c9fe479a11371f76b452e, type: 2}
