  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 2100000, guid: 35630e38b4e5ffb40b44ec5348b4333f, type: 2}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A slower, methodical approach that emphasizes control, careful clearing,
    and minimizing uncertainty. \\n Slower, can sacrifice momentum, and requires
    more coordination and discipline. \\n \t\u30B3\u30F3\u30C8\u30ED\u30FC\u30EB\u3001\u614E\u91CD\u306A\u969C\u5BB3\u7269\u306E\u30AF\u30EA\u30A2\u3001\u4E0D\u78BA\u5B9F\u6027\u306E\u6700\u5C0F\u5316\u3092\u91CD\u8996\u3059\u308B\u3001\u3088\u308A\u3086\u3063\u304F\u308A\u3068\u3057\u305F\u3001\u8A08\u753B\u7684\u306A\u30A2\u30D7\u30ED\u30FC\u30C1\u3002\\n
    \u30DA\u30FC\u30B9\u304C\u9045\u3044\u305F\u3081\u3001\u52E2\u3044\u3092\u640D\u306A\u3046\u53EF\u80FD\u6027\u304C\u3042\u308A\u3001\u3088\u308A\u9AD8\u3044\u9023\u643A\u3068\u898F\u5F8B\u304C\u6C42\u3081\u3089\u308C\u308B\u3002
    \\n \t\u4E00\u79CD\u8282\u594F\u8F83\u6162\u3001\u6709\u6761\u4E0D\u7D0A\u7684\u65B9\u6CD5\uFF0C\u5F3A\u8C03\u63A7\u5236\u3001\u8C28\u614E\u6E05\u7406\u4EE5\u53CA\u5C06\u4E0D\u786E\u5B9A\u6027\u964D\u81F3\u6700\u4F4E\u3002\\n
    \u8282\u594F\u8F83\u6162\uFF0C\u53EF\u80FD\u4F1A\u727A\u7272\u52BF\u5934\uFF0C\u4E14\u9700\u8981\u66F4\u5F3A\u7684\u534F\u8C03\u6027\u548C\u7EAA\u5F8B\u6027\u3002
    \\n \tUn enfoque m\xE1s lento y met\xF3dico que hace hincapi\xE9 en el control,
    la limpieza cuidadosa y la reducci\xF3n al m\xEDnimo de la incertidumbre. \\n
    Es m\xE1s lento, puede sacrificar el impulso y requiere m\xE1s coordinaci\xF3n
    y disciplina. \\n \uD1B5\uC81C\uB825, \uC2E0\uC911\uD55C \uC815\uB9AC, \uBD88\uD655\uC2E4\uC131
    \uCD5C\uC18C\uD654\uB97C \uC911\uC2DC\uD558\uB294, \uB354 \uB290\uB9AC\uACE0
    \uCCB4\uACC4\uC801\uC778 \uC811\uADFC \uBC29\uC2DD. \\n \uC18D\uB3C4\uAC00 \uB290\uB824
    \uCD94\uC9C4\uB825\uC744 \uC783\uC744 \uC218 \uC788\uC73C\uBA70, \uB354 \uB9CE\uC740
    \uD611\uB3D9\uACFC \uADDC\uC728\uC774 \uC694\uAD6C\uB41C\uB2E4."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e4797538af5c9fe479a11371f76b452e, type: 2}
