  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "There is no single technique that works for every situation. CQB methods
    are adapted to the environment, mission, team, and available information.  \\n
    \t\u3042\u3089\u3086\u308B\u72B6\u6CC1\u306B\u901A\u7528\u3059\u308B\u5358\u4E00\u306E\u30C6\u30AF\u30CB\u30C3\u30AF\u306A\u3069\u5B58\u5728\u3057\u307E\u305B\u3093\u3002CQB\u306E\u624B\u6CD5\u306F\u3001\u74B0\u5883\u3001\u4EFB\u52D9\u3001\u30C1\u30FC\u30E0\u3001\u305D\u3057\u3066\u5165\u624B\u53EF\u80FD\u306A\u60C5\u5831\u306B\u5FDC\u3058\u3066\u9069\u5FDC\u3055\u305B\u308B\u3082\u306E\u3067\u3059\u3002
    \\n \t\u6CA1\u6709\u4E00\u79CD\u6280\u672F\u80FD\u9002\u7528\u4E8E\u6240\u6709\u60C5\u51B5\u3002\u8FD1\u8DDD\u79BB\u4F5C\u6218\uFF08CQB\uFF09\u7684\u65B9\u6CD5\u9700\u6839\u636E\u73AF\u5883\u3001\u4EFB\u52A1\u3001\u56E2\u961F\u4EE5\u53CA\u53EF\u83B7\u5F97\u7684\u4FE1\u606F\u8FDB\u884C\u8C03\u6574\u3002
    \\n \tNo existe una t\xE9cnica \xFAnica que funcione en todas las situaciones.
    Los m\xE9todos de combate en espacios cerrados (CQB) se adaptan al entorno, a
    la misi\xF3n, al equipo y a la informaci\xF3n disponible. \\n\t\uBAA8\uB4E0 \uC0C1\uD669\uC5D0
    \uD1B5\uC6A9\uB418\uB294 \uB2E8\uC77C\uD55C \uAE30\uBC95\uC740 \uC5C6\uC2B5\uB2C8\uB2E4.
    CQB \uAE30\uBC95\uC740 \uD658\uACBD, \uC784\uBB34, \uD300, \uADF8\uB9AC\uACE0
    \uC785\uC218 \uAC00\uB2A5\uD55C \uC815\uBCF4\uC5D0 \uB9DE\uCDB0 \uC870\uC815\uB429\uB2C8\uB2E4.
    \\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e4797538af5c9fe479a11371f76b452e, type: 2}
